{
  "_comment": "Run from the repo root: python design/render.py .  (run python design/marketing/gen_banner.py first if the banner changed).",
  "jobs": [
    {
      "name": "shot-compress",
      "type": "png",
      "src": "design/app.html#screen=compress",
      "out": "assets/screenshots/discord-video-compressor.png",
      "w": 1280,
      "h": 800,
      "scale": 2
    },
    {
      "name": "shot-trim",
      "type": "png",
      "src": "design/app.html#screen=trim",
      "out": "assets/screenshots/trim-video-for-discord.png",
      "w": 1280,
      "h": 800,
      "scale": 2
    },
    {
      "name": "shot-batch",
      "type": "png",
      "src": "design/app.html#screen=batch",
      "out": "assets/screenshots/batch-video-compressor-queue.png",
      "w": 1280,
      "h": 800,
      "scale": 2
    },
    {
      "name": "shot-import",
      "type": "png",
      "src": "design/app.html#screen=import",
      "out": "assets/screenshots/twitch-clip-to-discord.png",
      "w": 1280,
      "h": 800,
      "scale": 2
    },
    {
      "name": "shot-output",
      "type": "png",
      "src": "design/app.html#screen=output",
      "out": "assets/screenshots/video-compression-settings-h264-h265-av1.png",
      "w": 1280,
      "h": 800,
      "scale": 2
    },
    {
      "name": "shot-settings",
      "type": "png",
      "src": "design/app.html#screen=settings",
      "out": "assets/screenshots/fitclip-settings-history.png",
      "w": 1280,
      "h": 800,
      "scale": 2
    },
    {
      "name": "gif-compress",
      "type": "gif",
      "src": "design/app.html#screen=compress&demo=compress",
      "out": "assets/gifs/compress-video-for-discord.gif",
      "w": 1280,
      "h": 800,
      "dur": 6000,
      "fps": 12,
      "out_w": 960,
      "colors": 128,
      "dither": "bayer:bayer_scale=5"
    },
    {
      "name": "gif-import",
      "type": "gif",
      "src": "design/app.html#screen=import&demo=import",
      "out": "assets/gifs/twitch-clip-download.gif",
      "w": 1280,
      "h": 800,
      "dur": 6000,
      "fps": 12,
      "out_w": 960,
      "colors": 128,
      "dither": "bayer:bayer_scale=5"
    },
    {
      "name": "gif-batch",
      "type": "gif",
      "src": "design/app.html#screen=batch&demo=batch",
      "out": "assets/gifs/batch-compress-videos.gif",
      "w": 1280,
      "h": 800,
      "dur": 6000,
      "fps": 12,
      "out_w": 960,
      "colors": 128,
      "dither": "bayer:bayer_scale=5"
    },
    {
      "name": "banner-png",
      "type": "png",
      "src": "design/marketing/banner.html",
      "out": "assets/banner.png",
      "w": 1280,
      "h": 400,
      "scale": 2,
      "t": 4200,
      "dur": 8000
    },
    {
      "name": "social",
      "type": "png",
      "src": "design/marketing/social.html",
      "out": "assets/social-preview.png",
      "w": 1280,
      "h": 640,
      "scale": 1
    }
  ]
}